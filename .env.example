# このファイルを ".env" にコピーして、自分で値を埋める（.env は .gitignore 済みなのでコミットされない）
# 値は Supabase ダッシュボード > Project Settings > API Keys から、各自が自分のアカウントでコピーする。
# チャット（LINE/Slack等）に鍵を貼って共有しないこと。

SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# publishable キー（旧UIでは anon キー）のみ。
# secret キー / service_role キーは RLS を無視して全データを操作できるので、絶対にここに入れない。
SUPABASE_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
